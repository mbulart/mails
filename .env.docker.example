APP_URL=https://email.batirenrdc.com
APP_HTTP_PORT=8088

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Kinshasa

LOG_CHANNEL=stack
LOG_STACK=single
